PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development

# Ecwid app credentials — get from your app at my.ecwid.com → Apps → Develop
# Required for both native (iframe) and external (OAuth) app types.
ECWID_CLIENT_ID=YOUR_CLIENT_ID
ECWID_CLIENT_SECRET=YOUR_CLIENT_SECRET

# Legacy single-store credentials (optional — only needed for local development
# or if migrating from a private app). For public apps, per-store tokens are
# obtained automatically via the iframe payload or OAuth install flow and stored
# in the database.
ECWID_STORE_ID=
ECWID_ACCESS_TOKEN=

# Change to a long random string in production
SESSION_SECRET=change_me

# Set to true to allow direct /admin access without an Ecwid iframe session
ALLOW_NO_ECWID=true

# URL of the Ecwid storefront page where the registry widget is embedded.
# All public-facing (shareable) registry links will point here.
# Example: https://yourecwidsite.com/registry
# If not set, links fall back to BASE_URL/registry (the standalone app page).
PUBLIC_REGISTRY_URL=

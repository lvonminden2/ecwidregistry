PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development

# Ecwid credentials — get from your app at my.ecwid.com → Apps → Develop
ECWID_STORE_ID=YOUR_STORE_ID
ECWID_ACCESS_TOKEN=YOUR_ACCESS_TOKEN
ECWID_CLIENT_SECRET=YOUR_CLIENT_SECRET

# Change to a long random string in production
SESSION_SECRET=change_me

# Set to true to allow direct /admin access without an Ecwid iframe session
ALLOW_NO_ECWID=true

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> — Le Petite Gourmet Shoppe</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
      <link href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
    <% } else { %>
      <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&family=Prata&display=swap" rel="stylesheet" />
    <% } %>
    <link rel="stylesheet" href="/public/styles.css" />
    <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
      <link rel="stylesheet" href="/public/admin.css" />
    <% } %>
    <!-- Ecwid native app SDK — required for iframe resizing and app initialization -->
    <script src="https://djqizrxa6f10j.cloudfront.net/ecwid-sdk/js/1.3.0/ecwid-app.js"></script>
    <script>
      // EcwidApp.init() must be called on every page inside the Ecwid iframe
      if (typeof EcwidApp !== 'undefined') {
        EcwidApp.init({
          app_id: "<%= typeof ecwidClientId !== 'undefined' ? ecwidClientId : '' %>",
          autoloadedflag: true,
          autoheight: true
        });
      }
    </script>
    <% if (typeof adminToken !== 'undefined' && adminToken) { %>
    <script>
      // Safari ITP: propagate admin store token via URL params since cookies are blocked
      (function() {
        var t = "<%= adminToken %>";
        if (!t) return;
        function addToken(url) {
          if (!url || !url.startsWith('/admin')) return url;
          return url + (url.indexOf('?') >= 0 ? '&' : '?') + '_t=' + encodeURIComponent(t);
        }
        document.addEventListener('click', function(e) {
          var a = e.target.closest('a[href]');
          if (a && a.getAttribute('href') && a.getAttribute('href').startsWith('/admin')) {
            a.href = addToken(a.getAttribute('href'));
          }
        }, true);
        document.addEventListener('submit', function(e) {
          var form = e.target;
          if (form.tagName === 'FORM' && form.action) {
            try {
              var u = new URL(form.action, location.origin);
              if (u.pathname.startsWith('/admin')) {
                var inp = form.querySelector('input[name="_t"]');
                if (!inp) {
                  inp = document.createElement('input');
                  inp.type = 'hidden';
                  inp.name = '_t';
                  form.appendChild(inp);
                }
                inp.value = t;
              }
            } catch(err) {}
          }
        }, true);
      })();
    </script>
    <% } %>
  </head>
  <body>
    <div class="page">

<%- include('../partials/header', { title: registry.display_name, isAdmin: true }) %>

<div class="toolbar">
  <div class="toolbar-left">
    <% if (registry.photo) { %>
      <img class="registry-photo-thumb" src="<%= registry.photo %>" alt="Registry photo" />
    <% } %>
    <div>
      <h1><%= registry.display_name %></h1>
      <div class="muted"><%= registry.event_date || 'No date set' %> · <%= registry.status %></div>
      <details class="edit-meta">
        <summary>Edit name / date</summary>
        <form method="post" action="/admin/registry/<%= registry.id %>/edit" class="edit-meta-form">
          <label class="field">
            <div class="label">Registry name</div>
            <input name="display_name" type="text" value="<%= registry.display_name %>" required />
          </label>
          <label class="field">
            <div class="label">Event date</div>
            <input name="event_date" type="date" value="<%= registry.event_date || '' %>" />
          </label>
          <label class="field">
            <div class="label">Description</div>
            <textarea name="description" rows="3" placeholder="Add a description for the registry..."><%= registry.description || '' %></textarea>
          </label>
          <button class="btn" type="submit">Save</button>
        </form>
      </details>
    </div>
  </div>
  <div class="toolbar-actions">
    <button class="btn secondary copy-link-btn" data-url="<%= publicRegistryUrl %>?reg=<%= registry.id %>">Copy link</button>
    <a class="btn secondary" target="_blank" rel="noopener noreferrer" href="<%= publicRegistryUrl %>?reg=<%= registry.id %>">View public page</a>
    <div class="toolbar-secondary">
      <a class="link" href="/admin/registry/<%= registry.id %>/print" target="_blank">Print</a>
      <span class="toolbar-sep">·</span>
      <a class="link" href="/admin">Back</a>
      <% if (registry.status === 'active') { %>
        <span class="toolbar-sep">·</span>
        <form method="post" action="/admin/registry/<%= registry.id %>/archive" style="display:inline">
          <button class="link-btn" type="submit">Archive</button>
        </form>
      <% } %>
    </div>
  </div>
</div>

<% if (actionError) { %>
  <div class="card"><div class="reg-error"><%= actionError %></div></div>
<% } %>
<% if (actionInfo) { %>
  <div class="card"><div style="color:#0cac42"><%= actionInfo %></div></div>
<% } %>

<!-- Add Item -->
<div class="card">
  <h2>Add Item</h2>

  <div class="search-wrap">
    <input id="product-search-input" type="text" placeholder="Search by name or SKU…" autocomplete="off" class="sku-input" />
    <div id="product-search-dropdown" class="search-dropdown" style="display:none"></div>
  </div>

  <!-- Hidden form submitted when the user picks a result -->
  <form id="product-add-form" method="post" action="/admin/registry/<%= registry.id %>/items" style="display:none">
    <input type="hidden" name="product_id" id="add-product-id" />
    <input type="hidden" name="product_name" id="add-product-name" />
    <input type="hidden" name="product_sku" id="add-product-sku" />
    <input type="hidden" name="unit_price" id="add-unit-price" />
    <input type="hidden" name="desired_qty" value="1" />
  </form>

  <div class="section-divider"><span>or add manually by SKU</span></div>

  <form method="post" action="/admin/registry/<%= registry.id %>/items" class="manual-add-form">
    <div class="sku-search-row">
      <input name="product_sku" type="text" required placeholder="SKU" class="sku-input" />
      <input name="desired_qty" type="number" min="1" value="1" class="qty-input" />
      <button class="btn" type="submit">Add item</button>
    </div>
  </form>
</div>

<!-- Items -->
<div class="card">
  <div class="card-header">
    <h2>Items</h2>
    <% if (items.length > 0) { %>
      <button class="btn secondary" id="export-excel-btn" style="font-size:12px;padding:5px 12px">Export to Excel</button>
    <% } %>
  </div>
  <% if (items.length === 0) { %>
    <div class="muted">No items yet.</div>
  <% } %>
  <% items.forEach(item => { %>
    <div class="row">
      <div>
        <div class="strong"><%= item.product_name || 'Registry item' %></div>
        <div class="muted" style="font-size:12px">
          <% if (item.unit_price != null) { %>$<%= Number(item.unit_price).toFixed(2) %><% if (item.supplier) { %> &nbsp;·&nbsp; <% } %><% } %>
          <% if (item.supplier) { %><%= item.supplier %><% } %>
        </div>
        <div class="item-progress">
          <span class="progress-label">Needed: <strong><%= item.still_needed %></strong></span>
          <span class="progress-sep">·</span>
          <span class="progress-label">Purchased: <strong><%= item.purchased_qty %></strong></span>
          <span class="progress-sep">·</span>
          <span class="progress-label muted">Goal: <%= item.desired_qty %></span>
        </div>
        <% if (item.product_sku) { %>
          <div class="muted" style="font-size:12px">SKU: <%= item.product_sku %></div>
        <% } %>
      </div>
      <div class="row-actions">
        <form method="post" action="/admin/registry/<%= registry.id %>/items/<%= item.id %>/quantity" class="qty-form">
          <input name="desired_qty" type="number" min="1" value="<%= item.desired_qty %>" style="width:60px" />
          <input name="unit_price" type="number" step="0.01" min="0" value="<%= item.unit_price != null ? item.unit_price : '' %>" placeholder="Price $" style="width:90px" />
          <input name="supplier" type="text" value="<%= item.supplier || '' %>" placeholder="Supplier" style="width:110px" />
          <button class="btn secondary" type="submit">Update</button>
        </form>
        <form method="post" action="/admin/registry/<%= registry.id %>/items/<%= item.id %>/delete" onsubmit="return confirm('Remove this item from the registry?');">
          <button class="btn secondary" type="submit">Delete</button>
        </form>
      </div>
    </div>
  <% }) %>
</div>

<script id="items-data" type="application/json"><%- JSON.stringify(items.map(function(i) {
  return { name: i.product_name || 'Registry item', sku: i.product_sku || '', supplier: i.supplier || '', price: i.unit_price != null ? Number(i.unit_price).toFixed(2) : '', desired: i.desired_qty, purchased: i.purchased_qty, still_needed: i.still_needed };
})) %></script>

<!-- Record Purchase -->
<div class="card">
  <h2>Record Purchase</h2>
  <div class="radio-group" style="margin-bottom:16px">
    <label class="radio-label">
      <input type="radio" name="purchase_type" value="in_store" checked /> In-store registry item
    </label>
    <label class="radio-label">
      <input type="radio" name="purchase_type" value="off_registry" /> Off-registry item
    </label>
  </div>

  <form method="post" action="/admin/registry/<%= registry.id %>/purchases" id="purchase-instore-form">
    <input type="hidden" name="channel" value="in_store" />
    <div class="grid">
      <label class="field">
        <div class="label">Registry item</div>
        <select name="product_id" required>
          <option value="">Select an item</option>
          <% items.forEach(item => { %>
            <option value="<%= item.product_id %>"><%= item.product_name || 'Registry item' %><% if (item.product_sku) { %> · <%= item.product_sku %><% } %></option>
          <% }) %>
        </select>
      </label>
      <label class="field">
        <div class="label">Quantity</div>
        <input name="qty" type="number" step="1" value="1" />
      </label>
      <label class="field">
        <div class="label">Buyer name</div>
        <input name="buyer_name" type="text" />
      </label>
      <label class="field">
        <div class="label">Buyer email</div>
        <input name="buyer_email" type="email" />
      </label>
    </div>
    <label class="field">
      <div class="label">Notes</div>
      <textarea name="notes" rows="2" placeholder="Optional note (gift receipt, return, etc.)"></textarea>
    </label>
    <button class="btn" type="submit" style="margin-top:4px">Record purchase</button>
  </form>

  <form method="post" action="/admin/registry/<%= registry.id %>/purchases/off-registry" id="purchase-offregistry-form" style="display:none">
    <div class="grid">
      <label class="field">
        <div class="label">Item name</div>
        <input name="product_name" type="text" required />
      </label>
      <label class="field">
        <div class="label">SKU (optional)</div>
        <input name="product_sku" type="text" />
      </label>
      <label class="field">
        <div class="label">Quantity</div>
        <input name="qty" type="number" step="1" value="1" />
      </label>
      <label class="field">
        <div class="label">Buyer name</div>
        <input name="buyer_name" type="text" />
      </label>
      <label class="field">
        <div class="label">Buyer email</div>
        <input name="buyer_email" type="email" />
      </label>
    </div>
    <label class="field">
      <div class="label">Notes</div>
      <textarea name="notes" rows="2" placeholder="Optional note"></textarea>
    </label>
    <button class="btn" type="submit" style="margin-top:4px">Record off-registry purchase</button>
  </form>
</div>

<!-- Purchases -->
<div class="card">
  <h2>Purchases</h2>
  <div class="purchases-summary">
    <div class="summary-stat">
      <div class="summary-val"><%= totalItems %></div>
      <div class="summary-label">Registry items</div>
    </div>
    <div class="summary-stat">
      <div class="summary-val"><% if (anyPriced) { %>$<%= totalDesiredValue.toFixed(2) %><% } else { %>—<% } %></div>
      <div class="summary-label">Total desired</div>
    </div>
    <div class="summary-stat">
      <div class="summary-val"><% if (anyPriced) { %>$<%= totalPurchasedValue.toFixed(2) %><% } else { %>—<% } %></div>
      <div class="summary-label">Total purchased</div>
    </div>
  </div>
  <% if (!anyPriced && items.length > 0) { %>
    <div class="muted" style="font-size:12px;margin-bottom:12px">Add prices to items above to see dollar totals.</div>
  <% } %>
  <% if (purchases.length === 0) { %>
    <div class="muted">No purchases yet.</div>
  <% } %>
  <% purchases.forEach(p => { %>
    <div class="row purchase-row">
      <div>
        <div class="strong">
          <span class="channel-badge channel-<%= p.channel %>"><%= p.channel.replace('_', ' ') %></span>
          <%= p.display_product_name || 'Registry item' %> · Qty <%= p.qty %>
        </div>
        <% if (p.off_registry) { %>
          <div class="muted">Off-registry</div>
        <% } %>
        <% if (p.display_product_sku) { %>
          <div class="muted" style="font-size:12px">SKU: <%= p.display_product_sku %></div>
        <% } %>
        <div class="muted"><%= p.buyer_name || 'Unknown buyer' %> · <%= p.buyer_email || '—' %></div>
        <% if (p.order_id) { %>
          <div class="muted">
            <% if (locals.ecwidStoreId) { %>
              <a href="https://my.ecwid.com/store/<%= ecwidStoreId %>/orders#order-<%= p.order_id %>" target="_blank" rel="noopener noreferrer">Order #<%= p.order_id %></a>
            <% } else { %>
              Order #<%= p.order_id %>
            <% } %>
          </div>
        <% } %>
        <% if (p.notes) { %>
          <div class="muted">Notes: <%= p.notes %></div>
        <% } %>
      </div>
      <div class="purchase-actions">
        <div class="muted" style="font-size:12px"><%= p.created_at %></div>
        <details class="purchase-edit">
          <summary>Edit</summary>
          <form method="post" action="/admin/registry/<%= registry.id %>/purchases/<%= p.id %>/update" class="purchase-edit-form">
            <% if (p.off_registry) { %>
              <label class="field">
                <div class="label">Item name</div>
                <input name="product_name" type="text" value="<%= p.display_product_name || '' %>" />
              </label>
              <label class="field">
                <div class="label">SKU</div>
                <input name="product_sku" type="text" value="<%= p.display_product_sku || '' %>" />
              </label>
            <% } %>
            <label class="field">
              <div class="label">Quantity</div>
              <input name="qty" type="number" step="1" value="<%= p.qty %>" />
            </label>
            <label class="field">
              <div class="label">Buyer name</div>
              <input name="buyer_name" type="text" value="<%= p.buyer_name || '' %>" />
            </label>
            <label class="field">
              <div class="label">Buyer email</div>
              <input name="buyer_email" type="email" value="<%= p.buyer_email || '' %>" />
            </label>
            <label class="field">
              <div class="label">Notes</div>
              <textarea name="notes" rows="2"><%= p.notes || '' %></textarea>
            </label>
            <div class="row-actions">
              <button class="btn secondary" type="submit">Save</button>
            </div>
          </form>
        </details>
        <form method="post" action="/admin/registry/<%= registry.id %>/purchases/<%= p.id %>/delete" onsubmit="return confirm('Delete this purchase record?');">
          <button class="btn secondary" type="submit">Delete</button>
        </form>
      </div>
    </div>
  <% }) %>
</div>

<!-- Registry Settings (collapsed by default) -->
<details class="settings-panel" <%= !registrantAccount ? 'open' : '' %>>
  <summary>Registry settings</summary>

  <div class="card">
    <h2>Shipping</h2>
    <form method="post" action="/admin/registry/<%= registry.id %>/shipping">
      <div class="radio-group">
        <label class="radio-label">
          <input type="radio" name="shipping_method" value="pickup" <%= (registry.shipping_method || 'pickup') === 'pickup' ? 'checked' : '' %> />
          Pick up in store
        </label>
        <label class="radio-label">
          <input type="radio" name="shipping_method" value="ship_to_registrant" <%= registry.shipping_method === 'ship_to_registrant' ? 'checked' : '' %> />
          Ship to registrant
        </label>
      </div>
      <div id="shipping-address-wrap" style="<%= registry.shipping_method === 'ship_to_registrant' ? '' : 'display:none;' %>margin-top:10px;">
        <label class="field">
          <div class="label">Shipping address</div>
          <textarea name="shipping_address" rows="3" placeholder="Street, City, State, ZIP"><%= registry.shipping_address || '' %></textarea>
        </label>
      </div>
      <button class="btn" type="submit" style="margin-top:10px">Save shipping</button>
    </form>
  </div>

  <div class="card">
    <h2>Registry Photo</h2>
    <% if (registry.photo) { %>
      <img class="registry-photo-preview" src="<%= registry.photo %>" alt="Registry photo" />
    <% } %>
    <form method="post" action="/admin/registry/<%= registry.id %>/photo" id="photo-form">
      <input type="hidden" name="photo_data" id="photo-data-input" value="" />
      <label class="field photo-file-label">
        <div class="label">Upload photo</div>
        <input type="file" id="photo-file-input" accept="image/*" />
      </label>
      <div class="photo-preview-wrap" id="photo-preview-wrap" style="display:none">
        <img id="photo-preview-img" src="" alt="Preview" class="registry-photo-preview" />
      </div>
      <div class="row-actions" style="margin-top:10px">
        <button class="btn" type="submit" id="photo-save-btn" disabled>Save photo</button>
        <% if (registry.photo) { %>
          <button class="btn secondary" type="button" id="photo-remove-btn">Remove photo</button>
        <% } %>
      </div>
    </form>
  </div>

  <div class="card">
    <h2>Registrant Access</h2>
    <% if (!registrantAccount) { %>
      <p class="muted" style="margin-bottom:14px">No portal access yet. Link an Ecwid customer account so the registrant can sign in with their existing store login.</p>
      <form method="post" action="/admin/registry/<%= registry.id %>/account">
        <label class="field">
          <div class="label">Name (optional)</div>
          <input name="name" type="text" placeholder="e.g. Jane & John" />
        </label>
        <label class="field">
          <div class="label">Registrant's Ecwid account email</div>
          <input name="email" type="email" required placeholder="registrant@example.com" />
        </label>
        <label class="radio-label" style="margin-bottom:14px">
          <input type="checkbox" name="can_add_items" value="1" style="width:auto" />
          <span>Allow registrant to add items</span>
        </label>
        <button class="btn" type="submit">Link account</button>
      </form>
    <% } else { %>
      <div class="row" style="padding-top:0">
        <div>
          <div class="strong"><%= registrantAccount.name || '(no name)' %></div>
          <div class="muted"><%= registrantAccount.email %></div>
          <% if (registrantAccount.ecwid_customer_id) { %>
            <div class="muted" style="font-size:11px">Ecwid customer #<%= registrantAccount.ecwid_customer_id %></div>
          <% } %>
          <div class="muted" style="margin-top:4px">
            Can add items: <span class="strong"><%= registrantAccount.can_add_items ? 'Yes' : 'No' %></span>
          </div>
        </div>
        <div class="row-actions">
          <form method="post" action="/admin/registry/<%= registry.id %>/account/toggle-items">
            <button class="btn secondary" type="submit"><%= registrantAccount.can_add_items ? 'Disable adding' : 'Allow adding' %></button>
          </form>
        </div>
      </div>
      <div style="margin-top:16px;padding-top:14px;border-top:1px solid var(--border)">
        <div class="label" style="margin-bottom:6px">Direct portal link (share with registrant)</div>
        <div style="display:flex;gap:8px;align-items:center">
          <code style="flex:1;font-size:12px;background:var(--bg);padding:6px 8px;border:1px solid var(--border);border-radius:4px;overflow:auto;white-space:nowrap"><%= portalLoginUrl %></code>
          <button class="btn secondary copy-link-btn" data-url="<%= portalLoginUrl %>" style="white-space:nowrap;flex-shrink:0">Copy</button>
        </div>
        <div class="muted" style="font-size:11px;margin-top:6px">The registrant visits this link and signs in with their store account — no password required.</div>
      </div>
      <div style="margin-top:14px;padding-top:14px;border-top:1px solid var(--border)">
        <div class="label" style="margin-bottom:6px">Embed in Ecwid Custom JavaScript</div>
        <div class="muted" style="font-size:12px;margin-bottom:8px">Add <strong>both</strong> scripts below to <strong>Ecwid Control Panel &rarr; Settings &rarr; Design &rarr; Custom JavaScript</strong>.</div>
        <code style="display:block;font-size:11px;background:var(--bg);padding:8px 10px;border:1px solid var(--border);border-radius:4px;overflow:auto;white-space:pre-wrap">&lt;script src="<%= portalWidgetUrl %>"&gt;&lt;/script&gt;
&lt;script src="<%= cartWidgetUrl %>"&gt;&lt;/script&gt;</code>
        <button class="btn secondary copy-link-btn" data-url='&lt;script src="<%= portalWidgetUrl %>"&gt;&lt;/script&gt;&#10;&lt;script src="<%= cartWidgetUrl %>"&gt;&lt;/script&gt;' style="margin-top:8px">Copy snippet</button>
      </div>
      <form method="post" action="/admin/registry/<%= registry.id %>/account/delete" onsubmit="return confirm('Remove registrant access? They will no longer be able to sign in.');" style="margin-top:16px">
        <button class="btn secondary" type="submit" style="font-size:10px">Remove access</button>
      </form>
    <% } %>
  </div>
</details>

<script>
// Export to Excel
(function(){
  var btn = document.getElementById('export-excel-btn');
  if (!btn) return;
  var items = JSON.parse(document.getElementById('items-data').textContent);
  var registryName = <%- JSON.stringify(registry.display_name) %>;
  btn.addEventListener('click', function() {
    var rows = [['Item', 'SKU', 'Supplier', 'Price', 'Desired', 'Purchased', 'Still Needed']];
    items.forEach(function(item) {
      rows.push([item.name, item.sku, item.supplier, item.price, item.desired, item.purchased, item.still_needed]);
    });
    var csv = rows.map(function(row) {
      return row.map(function(val) {
        var s = String(val == null ? '' : val).replace(/"/g, '""');
        return /[,"\n]/.test(s) ? '"' + s + '"' : s;
      }).join(',');
    }).join('\r\n');
    var blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = registryName.replace(/[^a-z0-9]/gi, '-').toLowerCase() + '-registry.csv';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });
})();

// Copy link buttons
document.querySelectorAll('.copy-link-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const url = btn.getAttribute('data-url');
    navigator.clipboard.writeText(url).then(() => {
      const orig = btn.textContent;
      btn.textContent = 'Copied!';
      setTimeout(() => { btn.textContent = orig; }, 2000);
    });
  });
});

// Shipping address toggle
(function(){
  var radios = document.querySelectorAll('input[name="shipping_method"]');
  var wrap = document.getElementById('shipping-address-wrap');
  radios.forEach(function(r) {
    r.addEventListener('change', function() {
      wrap.style.display = this.value === 'ship_to_registrant' ? '' : 'none';
    });
  });
})();

// Photo upload
(function(){
  const fileInput = document.getElementById('photo-file-input');
  const dataInput = document.getElementById('photo-data-input');
  const previewWrap = document.getElementById('photo-preview-wrap');
  const previewImg = document.getElementById('photo-preview-img');
  const saveBtn = document.getElementById('photo-save-btn');
  const removeBtn = document.getElementById('photo-remove-btn');

  fileInput.addEventListener('change', function(){
    const file = this.files[0];
    if (!file) return;
    if (file.size > 10 * 1024 * 1024) {
      alert('Image must be under 10 MB.');
      this.value = '';
      return;
    }
    const reader = new FileReader();
    reader.onload = function(e){
      dataInput.value = e.target.result;
      previewImg.src = e.target.result;
      previewWrap.style.display = 'block';
      saveBtn.disabled = false;
    };
    reader.readAsDataURL(file);
  });

  if (removeBtn) {
    removeBtn.addEventListener('click', function(){
      if (!confirm('Remove the photo from this registry?')) return;
      dataInput.value = '';
      saveBtn.disabled = false;
      document.getElementById('photo-form').submit();
    });
  }
})();

// Live product search
(function(){
  var input = document.getElementById('product-search-input');
  var dropdown = document.getElementById('product-search-dropdown');
  var addForm = document.getElementById('product-add-form');
  var SEARCH_URL = '/admin/registry/<%= registry.id %>/product-search';
  var debounce;

  input.addEventListener('input', function() {
    clearTimeout(debounce);
    var q = this.value.trim();
    if (q.length < 2) { dropdown.style.display = 'none'; return; }
    debounce = setTimeout(function(){ doSearch(q); }, 280);
  });

  input.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') { dropdown.style.display = 'none'; }
    if (e.key === 'ArrowDown') {
      var first = dropdown.querySelector('.search-result');
      if (first) { e.preventDefault(); first.focus(); }
    }
  });

  dropdown.addEventListener('keydown', function(e) {
    var focused = document.activeElement;
    if (e.key === 'ArrowDown' && focused.nextElementSibling) {
      e.preventDefault(); focused.nextElementSibling.focus();
    }
    if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (focused.previousElementSibling) focused.previousElementSibling.focus();
      else input.focus();
    }
    if (e.key === 'Enter' && focused.classList.contains('search-result')) {
      e.preventDefault(); focused.click();
    }
    if (e.key === 'Escape') { dropdown.style.display = 'none'; input.focus(); }
  });

  document.addEventListener('click', function(e) {
    if (!input.contains(e.target) && !dropdown.contains(e.target)) {
      dropdown.style.display = 'none';
    }
  });

  function doSearch(q) {
    dropdown.innerHTML = '<div class="search-loading">Searching…</div>';
    dropdown.style.display = 'block';
    fetch(SEARCH_URL + '?q=' + encodeURIComponent(q))
      .then(function(r){ return r.json(); })
      .then(function(items){ renderResults(items); })
      .catch(function(){ dropdown.innerHTML = '<div class="search-no-results">Search failed.</div>'; });
  }

  function renderResults(items) {
    if (!items.length) {
      dropdown.innerHTML = '<div class="search-no-results">No products found.</div>';
      return;
    }
    dropdown.innerHTML = items.map(function(item) {
      return '<div class="search-result" tabindex="0" data-id="' + esc(item.id) + '" data-name="' + esc(item.name) + '" data-sku="' + esc(item.sku) + '" data-price="' + esc(item.price || '') + '">' +
        '<span class="search-result-name">' + escHtml(item.name) + '</span>' +
        (item.sku ? '<span class="search-result-sku">' + escHtml(item.sku) + '</span>' : '') +
        '</div>';
    }).join('');
    dropdown.querySelectorAll('.search-result').forEach(function(el) {
      el.addEventListener('click', function(){ selectProduct(this.dataset.id, this.dataset.name, this.dataset.sku, this.dataset.price); });
    });
  }

  function selectProduct(id, name, sku, price) {
    document.getElementById('add-product-id').value = id;
    document.getElementById('add-product-name').value = name;
    document.getElementById('add-product-sku').value = sku;
    document.getElementById('add-unit-price').value = price || '';
    dropdown.style.display = 'none';
    addForm.submit();
  }

  function esc(v) { return String(v).replace(/"/g, '&quot;'); }
  function escHtml(v) {
    return String(v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }
})();

// Purchase type toggle
(function(){
  var radios = document.querySelectorAll('input[name="purchase_type"]');
  var instoreForm = document.getElementById('purchase-instore-form');
  var offForm = document.getElementById('purchase-offregistry-form');
  radios.forEach(function(r) {
    r.addEventListener('change', function() {
      if (this.value === 'in_store') {
        instoreForm.style.display = '';
        offForm.style.display = 'none';
      } else {
        instoreForm.style.display = 'none';
        offForm.style.display = '';
      }
    });
  });
})();
</script>


<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Registry — <%= registry.display_name %></title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: Arial, sans-serif;
      font-size: 13px;
      color: #000;
      background: #fff;
      padding: 32px 40px;
    }

    .print-header {
      margin-bottom: 16px;
      padding-bottom: 12px;
      border-bottom: 2px solid #000;
    }

    .print-title {
      font-size: 22px;
      font-weight: bold;
      margin-bottom: 4px;
    }

    .print-meta {
      font-size: 12px;
      color: #555;
    }

    /* ── Screen-only actions bar ── */
    .print-actions {
      margin-top: 14px;
      display: flex;
      gap: 8px;
    }

    .print-btn {
      background: #000;
      color: #fff;
      border: 1px solid #000;
      border-radius: 3px;
      padding: 6px 16px;
      font-family: Arial, sans-serif;
      font-size: 12px;
      cursor: pointer;
    }

    .print-btn.secondary {
      background: #fff;
      color: #000;
    }

    /* ── Options panel ── */
    .options-panel {
      margin: 16px 0;
      padding: 14px 16px;
      border: 1px solid #ccc;
      border-radius: 3px;
      background: #fafafa;
    }

    .options-row {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      align-items: flex-start;
    }

    .options-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .options-label {
      font-size: 11px;
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #555;
      margin-bottom: 2px;
    }

    .options-checks {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 16px;
    }

    .options-checks label {
      display: flex;
      align-items: center;
      gap: 5px;
      font-size: 13px;
      cursor: pointer;
    }

    .options-select {
      font-family: Arial, sans-serif;
      font-size: 13px;
      border: 1px solid #ccc;
      border-radius: 3px;
      padding: 4px 8px;
    }

    /* ── Table ── */
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 4px;
    }

    thead th {
      font-size: 11px;
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      text-align: left;
      padding: 8px 10px;
      border-top: 1px solid #000;
      border-bottom: 1px solid #000;
      white-space: nowrap;
    }

    tbody td {
      padding: 9px 10px;
      border-bottom: 1px solid #ccc;
      vertical-align: top;
    }

    tbody tr:last-child td { border-bottom: 1px solid #000; }

    .item-name { font-weight: bold; }
    .num { text-align: center; }

    .print-footer {
      margin-top: 16px;
      font-size: 11px;
      color: #555;
      display: flex;
      justify-content: space-between;
    }

    @media print {
      .print-actions,
      .options-panel { display: none !important; }
      body { padding: 0; }
      @page { margin: 18mm 16mm; }
      thead th { border-top: 2px solid #000; border-bottom: 2px solid #000; }
    }
  </style>
</head>
<body>

<div class="print-header">
  <div class="print-title"><%= registry.display_name %></div>
  <div class="print-meta">
    <% if (registry.event_date) { %>
      <%= new Date(registry.event_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %> &nbsp;&middot;&nbsp;
    <% } %>
    Registry items list
  </div>
  <div class="print-actions">
    <button class="print-btn" onclick="window.print()">Print / Save PDF</button>
    <button class="print-btn secondary" onclick="window.close()">Close</button>
  </div>
</div>

<!-- Options panel (hidden when printing) -->
<div class="options-panel">
  <div class="options-row">
    <div class="options-group">
      <div class="options-label">Columns</div>
      <div class="options-checks">
        <label><input type="checkbox" id="col-sku" checked /> SKU</label>
        <label><input type="checkbox" id="col-supplier" checked /> Supplier</label>
        <label><input type="checkbox" id="col-desired" checked /> Desired</label>
        <label><input type="checkbox" id="col-purchased" checked /> Purchased</label>
        <label><input type="checkbox" id="col-needed" checked /> Still Needed</label>
      </div>
    </div>
    <div class="options-group">
      <div class="options-label">Sort by</div>
      <select id="sort-select" class="options-select">
        <option value="default">Order added</option>
        <option value="name">Name A–Z</option>
        <option value="sku">SKU</option>
        <option value="supplier">Supplier</option>
        <option value="needed-desc">Still needed (most first)</option>
        <option value="desired-desc">Desired qty (most first)</option>
      </select>
    </div>
  </div>
</div>

<table id="items-table">
  <thead>
    <tr>
      <th id="th-name">Item</th>
      <th id="th-sku">SKU</th>
      <th id="th-supplier">Supplier</th>
      <th id="th-desired" class="num">Desired</th>
      <th id="th-purchased" class="num">Purchased</th>
      <th id="th-needed" class="num">Still Needed</th>
    </tr>
  </thead>
  <tbody id="items-tbody"></tbody>
</table>

<div class="print-footer" id="print-footer"></div>

<script>
var RAW_ITEMS = <%- JSON.stringify(items.map(function(i) {
  return {
    name: i.product_name || 'Registry item',
    sku: i.product_sku || '',
    supplier: i.supplier || '',
    desired: i.desired_qty,
    purchased: i.purchased_qty,
    still_needed: i.still_needed
  };
})) %>;

var COLS = {
  sku:       { el: null, th: 'th-sku',       index: 1 },
  supplier:  { el: null, th: 'th-supplier',  index: 2 },
  desired:   { el: null, th: 'th-desired',   index: 3 },
  purchased: { el: null, th: 'th-purchased', index: 4 },
  needed:    { el: null, th: 'th-needed',    index: 5 }
};

function getItems() {
  var sort = document.getElementById('sort-select').value;
  var items = RAW_ITEMS.slice();
  if (sort === 'name')         items.sort(function(a,b){ return a.name.localeCompare(b.name); });
  else if (sort === 'sku')     items.sort(function(a,b){ return a.sku.localeCompare(b.sku); });
  else if (sort === 'supplier')items.sort(function(a,b){ return a.supplier.localeCompare(b.supplier); });
  else if (sort === 'needed-desc')  items.sort(function(a,b){ return b.still_needed - a.still_needed; });
  else if (sort === 'desired-desc') items.sort(function(a,b){ return b.desired - a.desired; });
  return items;
}

function isColOn(key) {
  return document.getElementById('col-' + key).checked;
}

function esc(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

function render() {
  var items = getItems();
  var showSku      = isColOn('sku');
  var showSupplier = isColOn('supplier');
  var showDesired  = isColOn('desired');
  var showPurchased= isColOn('purchased');
  var showNeeded   = isColOn('needed');

  // Header columns
  document.getElementById('th-sku').style.display       = showSku       ? '' : 'none';
  document.getElementById('th-supplier').style.display  = showSupplier  ? '' : 'none';
  document.getElementById('th-desired').style.display   = showDesired   ? '' : 'none';
  document.getElementById('th-purchased').style.display = showPurchased ? '' : 'none';
  document.getElementById('th-needed').style.display    = showNeeded    ? '' : 'none';

  var rows = items.length === 0
    ? '<tr><td colspan="6" style="color:#555;padding:20px 10px">No items on this registry yet.</td></tr>'
    : items.map(function(item) {
        return '<tr>' +
          '<td class="item-name">' + esc(item.name) + '</td>' +
          (showSku       ? '<td>' + esc(item.sku) + '</td>' : '') +
          (showSupplier  ? '<td>' + esc(item.supplier) + '</td>' : '') +
          (showDesired   ? '<td class="num">' + item.desired + '</td>' : '') +
          (showPurchased ? '<td class="num">' + item.purchased + '</td>' : '') +
          (showNeeded    ? '<td class="num">' + item.still_needed + '</td>' : '') +
          '</tr>';
      }).join('');

  document.getElementById('items-tbody').innerHTML = rows;

  var totalNeeded = items.reduce(function(s, i) { return s + i.still_needed; }, 0);
  document.getElementById('print-footer').innerHTML =
    '<span>Printed ' + new Date().toLocaleDateString('en-US', { year:'numeric', month:'long', day:'numeric' }) + '</span>' +
    '<span>' + items.length + ' item' + (items.length !== 1 ? 's' : '') + ' &nbsp;&middot;&nbsp; ' + totalNeeded + ' still needed</span>';
}

// Wire up controls
['col-sku','col-supplier','col-desired','col-purchased','col-needed'].forEach(function(id) {
  document.getElementById(id).addEventListener('change', render);
});
document.getElementById('sort-select').addEventListener('change', render);

render();
</script>

</body>
</html>
